  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --black:   #0a0a12;
      --deep:    #0f0f1e;
      --card:    #13132a;
      --purple:  #6c3fc5;
      --purple-2:#9b59f5;
      --yellow:  #f5c518;
      --text:    #ffffff;
      --text-2:  #c8c8e8;
      --text-3:  #7878a8;
      --border:  rgba(108,63,197,0.2);
    }
    html { scroll-behavior: smooth; }
    body {
      background: var(--black);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      line-height: 1.7;
    }

    /* NAV */
    nav {
      background: var(--deep);
      border-bottom: 1px solid var(--border);
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .nav-logo {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
    }
    .nav-logo svg { width: 28px; height: 28px; }
    .nav-logo-text {
      font-weight: 800;
      font-size: 1.15rem;
      color: var(--text);
    }
    .nav-back {
      font-size: 0.82rem;
      color: var(--text-3);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      transition: color 0.2s;
    }
    .nav-back:hover { color: var(--text); }

    /* CONTENT */
    main {
      max-width: 760px;
      margin: 0 auto;
      padding: 3rem 1.5rem 5rem;
    }

    .page-eyebrow {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      color: var(--purple-2);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 0.75rem;
    }

    h1 {
      font-weight: 900;
      font-size: clamp(1.8rem, 5vw, 2.8rem);
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--text);
      margin-bottom: 0.5rem;
    }
    h1 span { color: var(--yellow); }

    .updated {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      color: var(--text-3);
      letter-spacing: 0.1em;
      margin-bottom: 3rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }

    .section-block {
      margin-bottom: 2.5rem;
    }

    h2 {
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--purple-2);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 0.75rem;
      padding-left: 0.75rem;
      border-left: 3px solid var(--purple);
    }

    p {
      font-size: 0.92rem;
      color: var(--text-2);
      line-height: 1.75;
      margin-bottom: 0.5rem;
    }

    ul {
      padding-left: 1.25rem;
      margin-top: 0.4rem;
    }
    li {
      font-size: 0.92rem;
      color: var(--text-2);
      line-height: 1.7;
      margin-bottom: 0.4rem;
    }
    li strong { color: var(--text); font-weight: 600; }

    a { color: var(--purple-2); text-decoration: none; }
    a:hover { text-decoration: underline; }

    .contact-box {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
      margin-top: 1rem;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .contact-box .icon {
      width: 42px; height: 42px;
      border-radius: 12px;
      background: rgba(108,63,197,0.2);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem;
      flex-shrink: 0;
    }
    .contact-box p { margin: 0; font-size: 0.88rem; }
    .contact-box strong { color: var(--text); display: block; font-size: 0.82rem; font-family: 'JetBrains Mono', monospace; letter-spacing: 0.05em; margin-bottom: 0.2rem; }

    .divider {
      height: 1px;
      background: var(--border);
      margin: 2.5rem 0;
    }

    /* FOOTER */
    footer {
      background: var(--deep);
      border-top: 1px solid var(--border);
      padding: 1.5rem 2rem;
      text-align: center;
    }
    .footer-text {
      font-size: 0.78rem;
      color: var(--text-3);
      font-family: 'JetBrains Mono', monospace;
    }
    .footer-text a { color: var(--purple-2); }

    @media (max-width: 600px) {
      main { padding: 2rem 1.25rem 4rem; }
      nav { padding: 0.9rem 1.25rem; }
    }
  </style>
